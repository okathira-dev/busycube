{
  "name": "Busycube: Web API Explorer",
  "name_localized": {
    "ja": "Busycube: Web APIエクスプローラー"
  },
  "short_name": "Busycube",
  "short_name_localized": {
    "ja": "Busycube"
  },
  "description": "A browser-powered puzzle game",
  "description_localized": {
    "ja": "ブラウザのWeb APIを使って解くパズルゲーム"
  },
  "lang": "en",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "related_applications": [
    { "platform": "webapp", "url": "/manifest.webmanifest", "id": "/" }
  ],
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Shortcut box",
      "name_localized": { "ja": "ショートカットの箱" },
      "short_name": "Shortcut",
      "short_name_localized": { "ja": "ショートカット" },
      "url": "/?stage=S-080&source=shortcut",
      "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/?stage=S-080&source=note"
  },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "text": "text" }
  },
  "file_handlers": [
    {
      "action": "/?stage=S-440",
      "accept": { "application/x-busycube": [".busycube"] }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+busycube",
      "url": "/?stage=S-450&entry=app&protocol=%s"
    }
  ],
  "background_color": "#100d1d",
  "theme_color": "#171329",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
