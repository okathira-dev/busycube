{
  "name": "Busycube: Web API Explorer",
  "name_localized": {
    "ja": "Busycube: Web APIエクスプローラー"
  },
  "short_name": "Busycube",
  "short_name_localized": {
    "ja": "Busycube"
  },
  "description": "A browser-powered puzzle game",
  "description_localized": {
    "ja": "ブラウザのWeb APIを使って解くパズルゲーム"
  },
  "lang": "en",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Shortcut box",
      "name_localized": { "ja": "ショートカットの箱" },
      "short_name": "Shortcut",
      "short_name_localized": { "ja": "ショートカット" },
      "url": "/?stage=S-310&source=shortcut",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "note_taking": {
    "new_note_url": "/?stage=S-310&source=note"
  },
  "share_target": {
    "action": "/?stage=S-240&share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "file_handlers": [
    {
      "action": "/?stage=S-440",
      "accept": { "application/x-busycube": [".busycube"] }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+busycube",
      "url": "/?stage=S-450&protocol=%s"
    }
  ],
  "background_color": "#100d1d",
  "theme_color": "#171329",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
