{
  "name": "busycube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "predev": "pnpm run busycube:stages:generate",
    "dev": "vite --host",
    "prebuild": "pnpm run busycube:stages:generate",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "markup": "markuplint \"src/**/*.{jsx,tsx,html}\"",
    "markup:fix": "markuplint \"src/**/*.{jsx,tsx,html}\" --fix",
    "check-biome": "biome check",
    "check-biome:fix": "biome check --write",
    "check": "pnpm run busycube:stages:check && pnpm run markup && pnpm run check-biome",
    "check:fix": "pnpm run markup:fix && pnpm run check-biome:fix",
    "pretest": "pnpm run busycube:stages:check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pretest:ci": "pnpm run busycube:stages:check",
    "test:ci": "jest --coverage --watchAll=false",
    "busycube:stages:generate": "node scripts/generateBusycubeStageIndex.mjs",
    "busycube:stages:check": "node scripts/generateBusycubeStageIndex.mjs --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "jsqr": "^1.4.0",
    "mediabunny": "1.55.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@testing-library/react": "^16.3.2",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "markuplint": "^4.18.3",
    "ts-jest": "^29.4.6",
    "ts-jest-mock-import-meta": "^1.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "lint-staged": {
    "*.{jsx,tsx,html}": [
      "markuplint"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,html}": [
      "biome check"
    ]
  },
  "volta": {
    "node": "24.14.0",
    "pnpm": "11.24.0"
  }
}
