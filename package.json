{
  "name": "busycube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run worker:check && tsc && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy --config dist/busycube/wrangler.json",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run --config dist/busycube/wrangler.json",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "docs:lint": "markdownlint-cli2",
    "docs:lint:fix": "markdownlint-cli2 --fix",
    "docs:links": "node scripts/checkMarkdownLinks.mjs",
    "markup": "markuplint \"src/**/*.{jsx,tsx,html}\"",
    "markup:fix": "markuplint \"src/**/*.{jsx,tsx,html}\" --fix",
    "check-biome": "biome check",
    "check-biome:fix": "biome check --write",
    "worker:check": "tsc --noEmit -p tsconfig.worker.json",
    "check": "pnpm run markup && pnpm run check-biome && pnpm run worker:check && pnpm run docs:lint && pnpm run docs:links",
    "check:fix": "pnpm run markup:fix && pnpm run check-biome:fix && pnpm run docs:lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:core": "vitest run --coverage --config vitest.core.config.ts",
    "test:e2e": "playwright test",
    "test:ci": "vitest run --coverage",
    "busycube:catalog:update": "node scripts/generateBusycubeStageCatalog.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "hono": "^4.13.7",
    "jsqr": "^1.4.0",
    "mediabunny": "1.56.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@markuplint/jsx-parser": "^5.0.0",
    "@markuplint/react-spec": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "compression": "^1.8.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.2",
    "markuplint": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "wrangler": "^4.131.1"
  },
  "lint-staged": {
    "*.{jsx,tsx,html}": [
      "markuplint"
    ],
    "*.{md,mdc}": [
      "markdownlint-cli2"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,html}": [
      "biome check"
    ]
  }
}
