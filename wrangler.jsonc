{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "busycube",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/payment/method",
      "/poc/payment/method",
      "/poc/payment/decoy-method",
      "/offline-beacon/network-probe"
    ]
  }
}
