{
  "extends": ["markuplint:recommended-react"],
  "rules": {
    "require-h1": false,
    "no-duplicate-h1": false,
    "no-pseudo-list": false,
    "performance/head-element-order": false,
    "code-styles/case-sensitive-attr-name": false,
    "security/no-event-handler-attr": false,
    "a11y/wai-aria/presentational-children": false
  },
  "parser": {
    ".[jt]sx$": "@markuplint/jsx-parser"
  },
  "specs": {
    ".[jt]sx$": "@markuplint/react-spec"
  },
  "excludeFiles": ["**/kojoall/**/*"]
}
